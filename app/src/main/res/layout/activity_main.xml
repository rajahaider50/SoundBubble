<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Floating Soundboard"
            android:textSize="13sp"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/btnOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1) Grant Overlay Permission"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnImportAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📄 Add a single audio file"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnImportFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📁 Add a whole folder"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnImportZip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗜 Add ZIP file (auto extract)"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnRecordAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎙 Record a new audio"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnBluetoothPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎧 Grant Bluetooth Permission"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnOutputMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔊 Output: Auto"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnLaunch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚀 Launch Floating Button"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saved Audios:"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="150dp" />

    </LinearLayout>
</ScrollView>
